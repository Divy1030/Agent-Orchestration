# Clerk secret key belongs only in the backend environment (local .env or Render).
CLERK_SECRET_KEY=sk_test_replace_me

# Exact browser origins allowed to present Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://agent-orchestration-dun.vercel.app
# Set once in the deployment secret store; generate with Fernet.generate_key().decode().
CREDENTIAL_ENCRYPTION_KEY=

# GitHub OAuth repository access is requested through Clerk when a user authorizes a Space.
# The `repo` scope is required for private repository access and branch/PR operations.
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional browser origins. Keep this explicit.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
